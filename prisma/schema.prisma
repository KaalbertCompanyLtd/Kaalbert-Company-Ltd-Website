// Prisma schema baseline (T1.2). Entities are added incrementally, epic by epic, as each
// docs/features/*.md's "Data requirements" section is built against (see CLAUDE.md's
// "Every entity field named in a docs/features/*.md ... maps to a Prisma schema field"
// rule). The migration tooling and conventions here are what every later epic's tasks
// build on.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// docs/features/home-page.md "Data requirements". Singleton row (queried via findFirst,
/// seeded/upserted with a fixed id) — no `site_settings`-style multi-tenancy applies here,
/// there is exactly one home page. Only the fields home-page.md's Data requirements section
/// actually names are modelled; the mockup's hero kicker, hero facts sidebar, method-strip
/// step copy, and trust band are fixed template chrome (not named as editable data in that
/// section) rather than an undocumented field invented for them — see memory/decision-log.md
/// (T2.1) for the reasoning.
model HomePageContent {
  id                  Int      @id @default(autoincrement())
  heroStatement       String   @map("hero_statement")
  primaryCtaLabel     String   @map("primary_cta_label")
  primaryCtaHref      String   @map("primary_cta_href")
  seniorAttentionCopy String   @map("senior_attention_copy")
  /// Up to 3 `article` ids; empty = most-recent-fallback per home-page.md's edge cases.
  /// No `article` table exists yet (insights-engine.md is Milestone 4, not built yet), so
  /// this is currently always empty and lib/home.ts's featured-articles resolver always
  /// returns none — see the code comment there.
  featuredArticleIds  Int[]    @default([]) @map("featured_article_ids")
  metaTitle           String   @map("meta_title")
  metaDescription     String   @map("meta_description")
  isPlaceholder       Boolean  @default(false) @map("is_placeholder")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("home_page_content")
}

/// docs/features/core-offer-pages.md "Data requirements" — full entity as of T2.2 (Core
/// Offer pages). `teaser` was added at T2.1 for the home/capabilities card blurb. T2.2 added
/// every remaining documented field, plus two fields not named in the feature doc but needed
/// once the full detail page was actually built (see memory/decision-log.md, T2.2):
/// `ctaLabel` (the doc only named `cta_href`, but the fee-panel CTA's button text differs per
/// offer — "Start with the free Health Check" vs. "Start a conversation" — and that's
/// firm-editable copy same as the href), and the `tiers` relation (`OfferTier`, below), which
/// resolves the Business Health Check two-tier pricing gap flagged at T2.1
/// (memory/technical-debt.md). `deliverables`/`clientInputs`/`indicativeTimeline` are used
/// directly by a single-tier offer (Financial Clarity Pack, Funding-Readiness Pack, whose
/// `tiers` relation is empty); a tiered offer (Business Health Check) leaves these three
/// empty/null on the parent row and carries the equivalent data per-tier instead, since each
/// tier has its own deliverables, required inputs and timeline. `methodStages`/`faqs` are
/// ordered lists stored as `Json` ({title, description}[] / {question, answer}[] respectively,
/// see lib/offers.ts's `MethodStage`/`OfferFaq` types) — no admin editor exists yet
/// (Milestone 7) to justify a fully relational shape for these today.
model Offer {
  id                 Int         @id @default(autoincrement())
  slug               String      @unique
  name               String
  teaser             String
  problemStatement   String      @map("problem_statement")
  whoFor             String      @map("who_for")
  whoNotFor          String      @map("who_not_for")
  /// Ordered `{title, description}[]`.
  methodStages       Json        @map("method_stages")
  /// Empty when this offer uses `tiers` instead (see model doc-comment above).
  deliverables       String[]    @default([])
  /// Empty when this offer uses `tiers` instead. A "list" per the feature doc even where a
  /// single-tier offer's mockup renders one paragraph — seeded as a one-element array so the
  /// render (`array.map` over `<p>`) reproduces the mockup exactly without special-casing.
  clientInputs       String[]    @default([]) @map("client_inputs")
  /// Null when this offer uses `tiers` instead (each tier carries its own `durationLabel`).
  indicativeTimeline String?     @map("indicative_timeline")
  feeAmountMin       Int         @map("fee_amount_min")
  feeAmountMax       Int         @map("fee_amount_max")
  feeCurrency        String      @map("fee_currency")
  scopeCap           String      @map("scope_cap")
  outOfScopeNote     String      @map("out_of_scope_note")
  /// Ordered `{question, answer}[]`, 3–5 real entries per core-offer-pages.md's business rule.
  faqs               Json
  ctaHref            String      @map("cta_href")
  ctaLabel           String      @map("cta_label")
  metaTitle          String      @map("meta_title")
  metaDescription    String      @map("meta_description")
  isPlaceholder      Boolean     @default(false) @map("is_placeholder")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  tiers              OfferTier[]

  @@map("offer")
}

/// New at T2.2 — resolves "Business Health Check's two-tier pricing has no real data model
/// yet" (memory/technical-debt.md). Only Business Health Check has rows here today; a
/// single-tier offer's `Offer.tiers` is simply empty and its own top-level
/// deliverables/clientInputs/indicativeTimeline/fee fields are used instead (see `Offer`'s
/// doc-comment). `isFeatured` marks which tier the offer detail page's fee-panel section
/// presents as "the published fee band" (BHC's own mockup: the Full tier) — the other
/// tier(s) surface as the panel's "alt-note" instead, by fee floor + duration.
model OfferTier {
  id            Int      @id @default(autoincrement())
  offerId       Int      @map("offer_id")
  offer         Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  name          String
  isFeatured    Boolean  @default(false) @map("is_featured")
  durationLabel String   @map("duration_label")
  /// Short form for the tier-meta line ("5 working days · single-location business"), e.g.
  /// "single-location business".
  scopeLabel    String   @map("scope_label")
  /// Full form for the fee-panel's "Scope cap:" line (FR-4.1's fee-band-plus-scope-cap
  /// element) — a fuller description than `scopeLabel`, e.g. Full's "up to 3 locations or
  /// business lines, 12 months of available records" vs. its `scopeLabel`'s shorter "up to
  /// three locations or business lines".
  scopeCap      String   @map("scope_cap")
  feeAmountMin  Int      @map("fee_amount_min")
  feeAmountMax  Int      @map("fee_amount_max")
  feeCurrency   String   @map("fee_currency")
  deliverables  String[] @default([])
  /// Same one-element-array-for-a-paragraph convention as `Offer.clientInputs`.
  clientInputs  String[] @default([]) @map("client_inputs")
  sortOrder     Int      @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([offerId, sortOrder])
  @@map("offer_tier")
}

/// The shared generic marketing-page entity (CLAUDE.md's Recurring Patterns: "the home for a
/// marketing page's own copy when it has no other entity to attach to"). New at T2.3
/// (Capabilities), keyed by `slug` since more than one page shares this model —
/// `capabilities-page.md`'s "Data requirements" names id/slug/hero_kicker/hero_heading/
/// hero_lead/meta_title/meta_description; `introCopy` isn't part of that list but is added
/// now per T2.3's own architecture constraint ("our-method-page.md (T2.4) reuses the same
/// page model with an added intro_copy field, so design it as a real shared model from the
/// start") — nullable and unused by the capabilities row.
model Page {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  heroKicker      String   @map("hero_kicker")
  heroHeading     String   @map("hero_heading")
  heroLead        String   @map("hero_lead")
  /// Unique to our-method-page.md (T2.4) — null for every other page's row, including
  /// capabilities.
  introCopy       String?  @map("intro_copy")
  metaTitle       String   @map("meta_title")
  metaDescription String   @map("meta_description")
  isPlaceholder   Boolean  @default(false) @map("is_placeholder")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("page")
}

/// docs/features/capabilities-page.md "Data requirements" — one of the 8 service-line
/// summaries on /capabilities. `order` is the field name the feature doc itself names (not
/// `sortOrder`, unlike `OfferTier.sortOrder` above, per CLAUDE.md's "every entity field named
/// in a docs/features/*.md ... maps to a Prisma schema field of the same name" rule).
model Capability {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  shortDescription String   @map("short_description")
  order            Int
  isPlaceholder    Boolean  @default(false) @map("is_placeholder")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("capability")
}

/// docs/features/capabilities-page.md "Data requirements" — a singleton (same
/// findFirst-by-fixed-id pattern as `HomePageContent`), deliberately a single recurring
/// `feeAmount` + `billingPeriod` rather than `OfferTier`'s multi-tier shape or the three core
/// offers' fee_amount_min/max band: a retainer is priced as one figure per period, not a
/// range with a scope cap (capabilities-page.md's business rules; core-offer-pages.md's band
/// shape doesn't apply here).
model AdvisoryRetainer {
  id            Int      @id @default(autoincrement())
  feeAmount     Int      @map("fee_amount")
  feeCurrency   String   @map("fee_currency")
  billingPeriod String   @map("billing_period")
  description   String
  isPlaceholder Boolean  @default(false) @map("is_placeholder")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("advisory_retainer")
}

/// docs/features/our-method-page.md "Data requirements" — one of the 4 stages of the firm's
/// method (Discover, Diagnose, Design, Deliver), rendered on /our-method in fixed order.
/// `order` follows `Capability.order`'s naming precedent (the feature doc's own field name,
/// not `sortOrder`). `whatHappens` is an added field beyond the feature doc's original
/// description/client_sees/decision_point list — needed once the page was built against
/// ui/mockups/a-public-site/our-method.html, whose `.stage-detail-grid` has three cells
/// ("What happens", "What the client sees", "Decision point") in addition to each stage's own
/// longer descriptive paragraph (`description`) — same precedent as T2.2 adding
/// `Offer.ctaLabel`/`tiers` beyond their feature doc's original field list (see
/// memory/decision-log.md). `capabilityTransferNote` is populated only for the final
/// (Deliver) stage per the feature doc's business rule — null for the other three.
model MethodStage {
  id                     Int      @id @default(autoincrement())
  name                   String
  order                  Int      @unique
  description            String
  whatHappens            String   @map("what_happens")
  clientSees             String   @map("client_sees")
  decisionPoint          String   @map("decision_point")
  capabilityTransferNote String?  @map("capability_transfer_note")
  isPlaceholder          Boolean  @default(false) @map("is_placeholder")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("method_stage")
}

/// docs/features/about-and-partners-page.md "Data requirements" — the founding
/// statement/values/standard `firm_statement` entity, decomposed into named fields the same
/// way `HomePageContent`/`Offer`/`MethodStage` decompose their own mockup sections, rather
/// than one opaque rich-text blob (the feature doc's one-line "rich content" description
/// doesn't preclude this — the mockup's four numbered value cards and two distinct panels
/// need their own fields to render, same reasoning as T2.4 adding `MethodStage.whatHappens`
/// beyond its feature doc's original list). Singleton row, same `findFirst`-by-fixed-id
/// pattern as `HomePageContent`/`AdvisoryRetainer`. The page's own hero
/// (kicker/heading/lead/meta) reuses the shared `Page` model instead (slug `"about"`), same
/// as capabilities/our-method — this entity holds only the content below the hero.
model FirmStatement {
  id             Int      @id @default(autoincrement())
  standingIntro  String   @map("standing_intro")
  /// Fixed 4-item ordered list ("What we stand on"'s value cards) — Integrity, Excellence,
  /// Partnership, Impact. A plain string array, not `Json`, since each value is just a name
  /// with no other per-value content in the mockup.
  values         String[]
  forwardHeading String   @map("forward_heading")
  forwardBody    String   @map("forward_body")
  /// "What we are not" panel's body paragraph — the panel heading itself is fixed template
  /// chrome (a standard compliance-disclaimer heading), not modelled as a field.
  scopeBody      String   @map("scope_body")
  isPlaceholder  Boolean  @default(false) @map("is_placeholder")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("firm_statement")
}

/// docs/features/about-and-partners-page.md / content-management-admin.md "Data
/// requirements" — shared with the not-yet-built insights-engine.md (article bylines).
/// `adminUserId` models the doc's `admin_user_id` FK for schema completeness only — no
/// `admin_user` table exists yet (Milestone 6, admin authentication), same precedent as
/// `HomePageContent.featuredArticleIds` pointing at the not-yet-built `article` table (T2.1,
/// see memory/decision-log.md) — not exercised by this task.
///
/// `photoUrl`/`credentials` are nullable, and `published` no longer gates on photo readiness
/// the way about-and-partners-page.md's original edge case specified — revised during T2.5
/// per explicit firm direction (memory/decision-log.md, session 11): a partner with no photo
/// yet still publishes, rendered with an initials avatar in `photoUrl`'s place (never a fake
/// placeholder image standing in for a real one), swapped for the real photo the moment one
/// is uploaded — no publish-state change required. `credentials` is similarly nullable where
/// a partner has no formal designation to state yet — never fabricated to fill the field,
/// rendered only when present. `bio` is deliberately NOT publish-gating (corrected at T7.6,
/// session 49: an earlier version of this doc-comment named it as a fourth gating field,
/// which neither feature doc ever did; `bio` has no live public reader yet at all, per its
/// own note below, so gating publish on it would have blocked every real profile).
///
/// `published` was originally fully computed (true the instant name/practiceArea/
/// personalStatement were all filled, false the instant any went blank) — revised at session
/// 60 to a **computed guard plus a manual override**: `lib/admin-authors.ts`'s `updateAuthor`
/// still rejects `published: true` while any of those three required fields is blank (the
/// original gate survives), but no longer force-sets the value from field completeness on
/// every save. An Owner (or the partner themselves, for their own profile) now explicitly
/// toggles it once the guard is satisfied, so a complete profile can be intentionally held
/// back or taken down without blanking real content — the gap that prompted this: there was
/// no way to do either before.
///
/// `order` follows `Capability.order`/`MethodStage.order`'s naming precedent (not named in
/// the feature doc) — needed to render exactly one partner as the page's single featured
/// "Lead Partner" card and the rest in a grid, in a stable, admin-editable order; the lowest
/// `order` value is the featured entry (see lib/about.ts's `getAuthors`).
///
/// `title` is new, added after the initial T2.5 build (session 11 follow-up): the mockup
/// combined a partner's rank ("Lead Partner", "Co-Founder") and their responsibility
/// ("Lead Consultant", "Growth, Markets & Clients") into one `practiceArea` string for the
/// featured partner only, and showed no rank at all for the other four (only the section
/// kicker said "Partners") — a real gap in the mockup itself, not something to preserve.
/// `title` now holds just the rank (rendered as a distinct badge, `app/about/page.tsx`'s
/// `PartnerAvatar`-adjacent title chip) and `practiceArea` holds just the responsibility, for
/// every partner uniformly. Defaults to `"Partner"` — a reasonable prefill for a newly
/// onboarded partner's profile once T7.6's Team editor exists; the lead/featured entry's row
/// overrides it to `"Lead Partner"`.
///
/// `articles` is the back-relation added at T4.1 (`insights-engine.md`) — this task reuses
/// this existing model as-is for article bylines rather than creating a second author entity
/// (see that task's own note); no other field here changes.
///
/// `adminUserId` is a real, unique `AdminUser` relation as of T7.6 (session 49) — previously
/// a schema-only placeholder `Int?` with nothing populating or reading it
/// (`memory/technical-debt.md` → "`Author.adminUserId` is still a schema-only placeholder
/// FK, not a real Prisma relation"). `@unique` because one login corresponds to at most one
/// public profile. Resolves the authenticated session's `admin_user.id` to the right
/// `author` row for T7.6's self-service editing — null for a partner whose public profile
/// exists but has no login account (yet) linked to it.
model Author {
  id                Int        @id @default(autoincrement())
  adminUserId       Int?       @unique @map("admin_user_id")
  adminUser         AdminUser? @relation(fields: [adminUserId], references: [id])
  name              String
  photoUrl          String?    @map("photo_url")
  title             String     @default("Partner")
  practiceArea      String     @map("practice_area")
  credentials       String?
  personalStatement String     @map("personal_statement")
  bio               String
  order             Int
  published         Boolean    @default(false)
  isPlaceholder     Boolean    @default(false) @map("is_placeholder")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  articles          Article[]

  @@map("author")
}

/// docs/features/content-management-admin.md "Data requirements" — the firm's single
/// contact-details record (new at T2.6, first materialized here — see
/// docs/tasks/02-public-presentation.md T2.6 and memory/decision-log.md). Same singleton
/// `findFirst`/fixed-id pattern as `HomePageContent`/`AdvisoryRetainer`/`FirmStatement`. Read
/// live by `SiteFooter`, `/contact`, and every `WhatsAppLinkButton` (CLAUDE.md's Recurring
/// Patterns) — but T2.6 only wires this into `/contact` and `WhatsAppLinkButton`; every public
/// page's existing `SiteFooter` call still passes literal hardcoded props (T1.5's own
/// precedent, since this table didn't exist yet) — tracked as new technical debt
/// (memory/technical-debt.md → "SiteFooter callers still pass hardcoded address/phone props
/// instead of reading site_settings"), sequenced into T7.8 rather than fixed here.
/// `responseTimeCommitment` is nullable: the firm hasn't confirmed a real commitment yet
/// (contact-and-enquiry.md's business rule — content the firm supplies and must actually be
/// able to keep), so `/contact` omits that panel entirely when null rather than rendering a
/// dev-facing "pending" placeholder as if it were real copy (content-management-admin.md's
/// edge case: a blank required field is omitted from the public display, not shown broken).
/// `socialProfileUrls` is added now per T2.6's own architecture constraint (schema
/// completeness for T2.8's SEO Organization schema `sameAs`), not exercised by this task.
model SiteSettings {
  id                     Int      @id @default(autoincrement())
  phonePrimary           String   @map("phone_primary")
  phoneSecondary         String?  @map("phone_secondary")
  email                  String
  whatsappNumber         String   @map("whatsapp_number")
  address                String
  responseTimeCommitment String?  @map("response_time_commitment")
  socialProfileUrls      String[] @default([]) @map("social_profile_urls")
  isPlaceholder          Boolean  @default(false) @map("is_placeholder")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

/// Shared across `contact-and-enquiry.md` (this task, write-only from `/contact`'s form),
/// `business-health-check-diagnostic.md` (Milestone 3, not yet built), and
/// `enquiry-management.md` (Milestone 8, not yet built) — see
/// docs/tasks/02-public-presentation.md T2.6's architecture constraints and
/// memory/decision-log.md for the field-by-field scoping decision made at this task.
///
/// At T2.6, `name`/`email`/`message`/`contactConsent` were modelled as required — correct for
/// that task's own contact-form contract, which always has them, but wrong once T3.5
/// (`docs/tasks/03-diagnostic.md`) needed to create a diagnostic-originated row before any of
/// them exist: `business-health-check-diagnostic.md`'s own Data requirements list says
/// "contact details (nullable until step 5)" — the diagnostic's step 4 result screen must
/// never require them (FR-2.3), and step 5's contact-consent ask (T3.7) is a later, separate
/// event entirely. Relaxed to nullable at T3.5 to actually honor that rule; `lib/enquiries.ts`'s
/// `createContactEnquiry` still enforces all four as required for a contact-form submission —
/// at the application layer now, not the schema — so that path's own behavior is unchanged.
/// `message` is a new field, not named in either feature doc's original "Data requirements"
/// list — added here the same way T2.2 added `Offer.ctaLabel`/`tiers` beyond their feature
/// doc's original field list, since the Input → Output contract requires a free-text form
/// body with nowhere else to live; both feature docs are updated to name it (see
/// memory/decision-log.md).
///
/// `scoreSummary`/`weakestDimensions`/`triageFlag` are business-health-check-diagnostic.md's
/// documented diagnostic-specific fields, modelled now as nullable/empty so the column shape
/// exists for Milestone 3 to populate, but left unpopulated by every contact-form-originated
/// row this task creates (T2.6's own explicit allowance) — the `diagnostic_response` set
/// relation that same doc names is deliberately NOT modelled yet, unlike these three: unlike
/// `HomePageContent.featuredArticleIds` (a scalar array that can point at a not-yet-built
/// table), a real Prisma relation field needs the related model to already exist, and
/// `diagnostic_response` doesn't (Milestone 3) — Milestone 3's own task adds that relation.
///
/// `traffic_source`/`campaign`/`landing_page`, also named in
/// business-health-check-diagnostic.md's Data requirements list, are deliberately NOT
/// modelled here: `measurement-and-attribution.md`'s own Data requirements section describes
/// per-enquiry attribution differently — a separate `attribution` entity (session id,
/// utm_source/medium/campaign, landing_page, first_seen) with a foreign key from
/// `enquiry_record`, not inline columns on this table. The two feature docs disagree on the
/// real shape; T2.6 doesn't own either the diagnostic or measurement features, so it leaves
/// this inconsistency for whichever future task actually builds attribution (Milestone 5,
/// `docs/tasks/05-landing-and-measurement.md`) to resolve, rather than guessing a column shape
/// now that would likely need replacing.
///
/// `enquiry-management.md`'s own extension (`status`, `assigned_partner_id`,
/// `internal_notes`, `status_updated_at`) was Milestone 8 scope, not anticipated at T2.6 — see
/// the field-level doc-comments below for how T8.1 actually added it.
model EnquiryRecord {
  id                    Int                  @id @default(autoincrement())
  name                  String?
  email                 String?
  phone                 String?
  message               String?
  serviceLine           String?              @map("service_line")
  contactConsent        Boolean?             @map("contact_consent")
  marketingConsent      Boolean              @default(false) @map("marketing_consent")
  /// Diagnostic-specific, null for every contact-form-originated row (see model doc-comment).
  scoreSummary          Json?                @map("score_summary")
  weakestDimensions     String[]             @default([]) @map("weakest_dimensions")
  triageFlag            Boolean?             @map("triage_flag")
  /// Added at T8.1 — `lib/diagnostic-scoring.ts`'s `resolveTriageBand` already computed this
  /// per submission (`overallPriorityLevel`, "High"/"Medium"/"Low" from
  /// `diagnostic_threshold.triagePriorityLevel`) but it was only ever embedded in
  /// `indicativeCostStatement`'s prose, never persisted structurally — no admin screen could
  /// read it back (memory/technical-debt.md's now-resolved "Enquiry-level triage priority...
  /// never persisted" entry). Plain `String?`, not an enum, same reasoning as
  /// `DiagnosticThreshold.triagePriorityLevel` above: the firm's triage vocabulary is tunable
  /// admin data (Milestone 7), not a fixed closed set the schema should lock in. Null for
  /// every contact-form-originated row and for a diagnostic row whose score breached no
  /// threshold, same nullability precedent as `triageFlag`/`scoreSummary`.
  triagePriorityLevel   String?              @map("triage_priority_level")
  createdAt             DateTime             @default(now()) @map("created_at")
  /// Added at T8.1 (`enquiry-management.md`'s own Data requirements) — the status-driven
  /// triage workflow a partner works an enquiry through. A real, closed 5-value Prisma enum
  /// (`EnquiryStatus`, see its own doc-comment below) rather than a plain string like
  /// `AdminUser.role`: unlike `role`, this vocabulary is fixed by the feature doc itself, not
  /// left open for the firm to extend — the same distinction that already puts
  /// `DiagnosticResponseType`/`AdminLoginAttemptKind` in this schema as real enums.
  /// `@default(new)` backfills every pre-T8.1 row to "new" (this task's own Input → Output
  /// contract) and is the correct starting state for every row created from here on too.
  status                EnquiryStatus        @default(new)
  /// Added at T8.1 — nullable (`enquiry-management.md`: "an enquiry is not required to be
  /// assigned to anyone"). `onDelete: SetNull`, not `Restrict` or `Cascade`: an admin_user
  /// being deactivated/removed must never block or cascade-delete the enquiries they were
  /// once assigned — the enquiry just becomes unassigned again, same defensive precedent as
  /// `attributionId` above.
  assignedPartnerId     Int?                 @map("assigned_partner_id")
  assignedPartner       AdminUser?           @relation(fields: [assignedPartnerId], references: [id], onDelete: SetNull)
  /// Added at T8.1 — admin-only, never visitor-facing (`enquiry-management.md`'s own business
  /// rule). Free text, no structure: this is a partner's working notes on one enquiry, not
  /// content with any admin-editable-content precedent elsewhere in this schema.
  internalNotes         String?              @map("internal_notes")
  /// Added at T8.1 — when `status` last changed. Defaults to `now()` so a backfilled
  /// pre-T8.1 row has a real, honest timestamp (the moment this column started existing,
  /// since no earlier status-change moment exists to record) rather than null; every future
  /// write that changes `status` (T8.3's `PATCH` handler) must also set this explicitly —
  /// it does not auto-update the way `updatedAt` columns elsewhere in this schema do, because
  /// it tracks one specific field's change, not "last modified in any way."
  statusUpdatedAt       DateTime             @default(now()) @map("status_updated_at")
  /// Added at T8.4 (FR-6.4) — when a partner deleted this enquiry's personal data on request
  /// (`lib/admin-enquiries.ts`'s `deletePersonalData`, which nulls `name`/`email`/`phone`/
  /// `message` but leaves this row and its non-personal fields intact for KPI counting). Null
  /// for the overwhelming majority of rows, which have never had a deletion request; this
  /// column exists specifically so the admin UI can tell "this visitor never gave a name"
  /// (also null, but `personalDataDeletedAt` too) apart from "this visitor's name existed and
  /// was deleted on request" — collapsing both into an indistinguishable null `name` would
  /// silently misrepresent a real deletion as if it had simply never happened. The firm
  /// confirmed at T8.4 (session 59, 2026-09-12) that a `converted` enquiry is deleted exactly
  /// like any other status — no special-cased retention exists here.
  personalDataDeletedAt DateTime?            @map("personal_data_deleted_at")
  /// Added at T3.1 (`docs/tasks/03-diagnostic.md`) — the relation
  /// `business-health-check-diagnostic.md`'s own Data requirements section names for this
  /// entity, deferred at T2.6 because `DiagnosticResponse` didn't exist yet (see the model
  /// doc-comment above). Empty for every contact-form-originated row, same as
  /// `scoreSummary`/`weakestDimensions`/`triageFlag`.
  diagnosticResponses   DiagnosticResponse[]
  /// Added at T5.4 — the foreign key `measurement-and-attribution.md`'s Data requirements
  /// section names ("every enquiry_record carries a foreign key to its originating
  /// attribution row"), deferred at T2.6 because `Attribution` didn't exist yet (see
  /// `memory/decision-log.md`, T2.6). Nullable: a row created before this task shipped, or a
  /// submission where attribution capture failed/was unavailable (e.g. localStorage
  /// disabled), has no attribution — this must never block enquiry creation, per this task's
  /// own edge case. `onDelete: SetNull`, not `Cascade` or `Restrict` — the 90-day retention
  /// job deletes the `Attribution` row itself once it's old enough and unreferenced; an
  /// `EnquiryRecord` that still exists at that point already has no other Attribution to lose
  /// (the job explicitly skips referenced rows), but `SetNull` is the correct, defensive
  /// choice regardless of deletion order.
  attributionId         Int?                 @map("attribution_id")
  attribution           Attribution?         @relation(fields: [attributionId], references: [id], onDelete: SetNull)

  @@map("enquiry_record")
}

/// docs/features/business-health-check-diagnostic.md "Data requirements" — one of the 4–5
/// scored dimensions a `diagnostic_question` belongs to (structure, records, cash, controls,
/// funding readiness, owner dependence, per that doc's "User flow" step 2). `weight` is a
/// plain numeric field (not `Json`/structured) specifically so T3.2's scoring function can do
/// arithmetic directly against it — see this task's own architecture constraint on shaping
/// fields for the scoring function's consumption, not just admin-editing convenience. No
/// `active` flag here (unlike `DiagnosticQuestion`): a dimension with zero active questions is
/// the documented edge case the scoring function itself must catch and log (FR-2.2's edge
/// case), not something this table hides by deactivating the dimension row.
model DiagnosticDimension {
  id         Int                   @id @default(autoincrement())
  name       String
  weight     Float
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  questions  DiagnosticQuestion[]
  thresholds DiagnosticThreshold[]

  @@map("diagnostic_dimension")
}

/// docs/features/business-health-check-diagnostic.md "Data requirements" — one question in
/// the diagnostic's question set. `dimensionId` is a real FK (not an inline string) so T3.2's
/// scoring function can join straight from a response to its dimension's weight; ADR 0005's
/// "supports more dimensions/questions than launch config ships with" requirement is what a
/// plain relational FK plus this `active` flag directly satisfies — a new question or
/// dimension is an `INSERT`, never a code change. `order` follows `Capability.order`/
/// `MethodStage.order`'s established naming precedent (the feature doc's own field name, not
/// `sortOrder`). `responseType` is a Prisma enum (scale/boolean/choice, per the feature doc)
/// rather than a free string, so an invalid value is rejected at the database layer, not
/// silently accepted as scoring-engine input. `active` lets a question be retired from the
/// live flow without deleting historical `DiagnosticResponse` rows that reference it (T3.2's
/// scoring function only ever queries `active: true` questions).
///
/// `choiceOptions` is new at T7.7 (session 50) — a real column at last for a `choice`
/// question's option label-to-value mapping, null for `scale`/`boolean` questions (their
/// option sets are fixed/universal, `lib/diagnostic-flow-options.ts`'s
/// `DIAGNOSTIC_SCALE_OPTIONS`/`DIAGNOSTIC_BOOLEAN_OPTIONS`). Previously this mapping lived
/// only in that same client-safe file, hard-coded and keyed by `${dimensionId}-${order}` —
/// safe as long as nothing ever reordered or created a `choice` question, which is exactly
/// what T7.7's own admin editor needs to do; discovered and fixed in the same task rather
/// than left as a live trap for the first real reorder/create.
/// `isPlaceholder` is new at T7.7 too — closes `memory/technical-debt.md` →
/// "`diagnostic_question` has no queryable `is_placeholder` column" (T3.3 could only flag the
/// launch question set's pending-review status in `prisma/seed.ts`'s own comment, since this
/// column didn't exist yet).
model DiagnosticQuestion {
  id            Int                    @id @default(autoincrement())
  promptText    String                 @map("prompt_text")
  dimensionId   Int                    @map("dimension_id")
  dimension     DiagnosticDimension    @relation(fields: [dimensionId], references: [id], onDelete: Restrict)
  order         Int
  responseType  DiagnosticResponseType @map("response_type")
  /// Ordered `{label, value}[]` — `value` a numeric string already normalized to 0–1, the
  /// same convention every `DiagnosticResponse.answerValue` carries. Required when
  /// `responseType` is `choice`, null otherwise — enforced by `lib/admin-diagnostic.ts`, not
  /// the database (Prisma has no conditional-column-requirement construct).
  choiceOptions Json?                  @map("choice_options")
  active        Boolean                @default(true)
  isPlaceholder Boolean                @default(false) @map("is_placeholder")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  responses     DiagnosticResponse[]

  @@unique([dimensionId, order])
  @@map("diagnostic_question")
}

/// The three response shapes `business-health-check-diagnostic.md`'s "Data requirements"
/// section names for `diagnostic_question.response_type` (scale/boolean/choice).
enum DiagnosticResponseType {
  scale
  boolean
  choice
}

/// docs/features/enquiry-management.md "Data requirements" — T8.1. The fixed, closed
/// 5-value workflow `EnquiryRecord.status` moves through (the feature doc's own
/// "new/contacted/closed/converted/not-a-fit" list). `not_a_fit` is the Prisma-identifier
/// spelling of that last value (an enum member name can't contain a hyphen) — the generated
/// client emits it as a plain string-keyed const object (see `generated/prisma/enums.ts`'s
/// existing `DiagnosticResponseType`/`AdminLoginAttemptKind` output), so this is purely an
/// identifier-naming constraint, not a stored-value change; nothing outside this schema file
/// depends on the literal spelling "not-a-fit".
enum EnquiryStatus {
  new
  contacted
  closed
  converted
  not_a_fit
}

/// docs/features/business-health-check-diagnostic.md "Data requirements" — a scoring
/// threshold, keyed either to one dimension or to the overall score (`dimensionId` null for
/// an overall threshold, per the feature doc's "dimension or overall" wording) — mirrors
/// `LegalPage`'s and other nullable-FK precedents elsewhere in this schema rather than a
/// separate `scope` discriminator column, since "which dimension, or none" is exactly what a
/// nullable FK already expresses. `triagePriorityLevel` is a plain string (not an enum): the
/// feature doc doesn't enumerate a fixed, closed set of priority levels the way it does for
/// `response_type`, and the firm's own triage vocabulary (FR-2.6) is expected to be tuned via
/// data during Milestone 7's config admin, not fixed at the schema layer.
model DiagnosticThreshold {
  id                  Int                  @id @default(autoincrement())
  dimensionId         Int?                 @map("dimension_id")
  dimension           DiagnosticDimension? @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  thresholdValue      Float                @map("threshold_value")
  triagePriorityLevel String               @map("triage_priority_level")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("diagnostic_threshold")
}

/// docs/features/business-health-check-diagnostic.md "User flow" step 4 — the visitor-facing
/// descriptive band an overall score falls into (the accepted mockup's own "Strong
/// Foundation"/"Running on Memory" style labels + one-paragraph statements,
/// `ui/mockups/c-diagnostic/diagnostic-results.html`'s `BANDS` array). Deliberately its own
/// model, not an extension of `DiagnosticThreshold`: bands cover the full 0–100 range with no
/// gaps (every score matches exactly one band, looked up by the band with the highest
/// `minScore` not exceeding the actual score — mirrors the mockup's own `BANDS.find(b =>
/// score >= b.min)`), while thresholds are sparse triage cutoffs that may not be breached at
/// all and serve a different, internal/partner-facing purpose
/// (`triagePriorityLevel`) — the two didn't fit the same shape. Added at T3.6/T7.7 (session
/// 22) after `app/diagnostic/results/page.tsx` (T3.6) first shipped without this element,
/// substituting the real, already-computed `indicativeCostStatement` in its place — see
/// memory/decision-log.md and memory/technical-debt.md for the full reasoning. Seeded with
/// the mockup's own illustrative wording, `isPlaceholder: true` (a real column here from the
/// start, unlike `DiagnosticQuestion`'s own gap), pending firm review, same treatment as the
/// question set (T3.3).
model DiagnosticScoreBand {
  id            Int      @id @default(autoincrement())
  minScore      Int      @map("min_score")
  label         String
  statement     String
  /// The band's fuller narrative, sent only in the "full written summary" email
  /// (`lib/diagnostic-request-summary.ts`) — deliberately separate from `statement` (the short
  /// version `/diagnostic/results` shows on screen) so the two can diverge: the results screen
  /// stays a teaser by design (FR-2.3 — value delivered before any contact ask, but not the
  /// full picture), and the emailed version is what actually earns the name "full written
  /// summary." Supports multiple paragraphs (split on a blank line) for a genuinely longer
  /// narrative than the one-line on-screen statement.
  emailDetail   String   @default("") @map("email_detail")
  isPlaceholder Boolean  @default(true) @map("is_placeholder")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("diagnostic_score_band")
}

/// docs/features/business-health-check-diagnostic.md "Data requirements" — one visitor's
/// answer to one question within a single diagnostic session. `sessionId` is a plain string
/// (not a FK to any session/auth table — this diagnostic has no visitor account, per ADR
/// 0005/0007's scope) correlating every response in one attempt before submission creates the
/// owning `EnquiryRecord`. `enquiryId` is nullable rather than required — T3.4's actual client
/// flow (`components/diagnostic-flow.tsx`) holds every answer in client-side state only and
/// POSTs the complete set in a single `POST /api/diagnostic/submit` request (T3.5), which
/// creates every `DiagnosticResponse` row together with its owning `EnquiryRecord` in one
/// write, so `enquiryId` is in practice always populated at creation time; nullability here is
/// schema robustness (this column doesn't itself enforce "always populated"), not evidence of
/// an incremental per-step write path that was never actually built. `answerValue` is a plain
/// string (not `Json`/numeric) holding a number already normalized to 0–1, uniformly across
/// every `responseType` — decided at T3.2 (`lib/diagnostic-scoring.ts`), mirroring exactly how
/// the accepted mockup (`ui/mockups/c-diagnostic/diagnostic-flow.html`) resolves every input's
/// value client-side before submission: a boolean's Yes/No is `1`/`0`, a scale's 1–5 rating is
/// `v / 5`, and each choice option carries its own pre-authored 0–1 value (e.g. "3–12 months"
/// → `0.66`) — there is no column here to store a choice option's label-to-value mapping, so
/// that mapping lives in `lib/diagnostic-flow-options.ts` (T3.4), carried over verbatim from
/// `prisma/seed.ts`'s own per-question comments. `responseType` therefore only drives which
/// input widget T3.4 renders, not how T3.2 interprets the resulting value. The feature doc's
/// own field list is
/// descriptive English ("session id", "answer value"), not literal snake_case identifiers
/// (contrast `home-page.md`'s literal `hero_statement` list) — same treatment as this file's
/// `active flag` → `active` and `dimension or overall` → nullable `dimensionId` above. Its
/// "timestamp" is modelled as `createdAt`/`created_at`, matching every other model's
/// timestamp field in this schema (`EnquiryRecord.createdAt` included) rather than a one-off
/// `timestamp` column name.
model DiagnosticResponse {
  id          Int                @id @default(autoincrement())
  sessionId   String             @map("session_id")
  questionId  Int                @map("question_id")
  question    DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answerValue String             @map("answer_value")
  enquiryId   Int?               @map("enquiry_id")
  enquiry     EnquiryRecord?     @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("diagnostic_response")
}

/// docs/features/legal-and-compliance-pages.md "Data requirements" — one of the four fixed
/// legal documents (privacy-notice, cookie-notice, terms-of-use, scope-of-practice), each at
/// its own stable `/legal/[slug]` URL (never one combined page with anchors — advertising
/// platforms require a direct privacy-policy URL, per that doc's business rules). `body` is
/// an ordered array of content blocks (see lib/legal.ts's `LegalPageBlock` type) rather than
/// one opaque rich-text blob — the four real mockups (ui/mockups/e-legal/*.html) don't share
/// one uniform shape (a highlighted statement box, plain prose, a "pending — real text not
/// yet supplied" note, and a data table all appear across the four pages) — same "no admin
/// editor yet to justify full relational modelling" reasoning as `Offer.methodStages`/`faqs`.
/// `metaDescription` is added beyond the feature doc's original id/slug/title/body/
/// last_revised_at list per CLAUDE.md's "every public page type carries meta_title/
/// meta_description" rule — `title` itself doubles as the page's meta title (no mockup shows
/// SEO title text distinct from the visible H1), same precedent as T2.2/T2.4 adding fields
/// beyond a feature doc's original list (see memory/decision-log.md). `isPlaceholder`
/// defaults `true` here — unlike every other placeholder-flagged model in this schema, which
/// defaults `false` — because three of the four real seeded rows are illustrative drafts
/// pending the firm's actual legal text (Document 13.03, Section 13); a `false` default would
/// misrepresent the norm for this one entity.
model LegalPage {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  title           String
  /// Ordered `LegalPageBlock[]` — see lib/legal.ts.
  body            Json
  metaDescription String    @map("meta_description")
  lastRevisedAt   DateTime? @map("last_revised_at")
  isPlaceholder   Boolean   @default(true) @map("is_placeholder")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("legal_page")
}

/// docs/features/legal-and-compliance-pages.md "Data requirements" — the shared footer's
/// legal/compliance text, a singleton (same `findFirst`/fixed-id pattern as `SiteSettings`/
/// `FirmStatement`), distinct from `site_settings` (contact details) per that doc's own
/// business rule. `companyRegistrationDetails` stays null until the firm supplies it
/// post-incorporation (FR-5.2's edge case: omitted from the footer entirely while null, never
/// a placeholder). Not yet wired into `SiteFooter`/`ScopeOfPracticeNote` — both still render
/// T1.5's original hardcoded copy — same gap already flagged for `SiteSettings`
/// (memory/technical-debt.md → "SiteFooter callers still pass hardcoded address/phone props"),
/// logged again here rather than silently left unnoticed, sequenced into that same T7.8 fix.
model FooterContent {
  id                         Int      @id @default(autoincrement())
  scopeOfPracticeStatement   String   @map("scope_of_practice_statement")
  companyRegistrationDetails String?  @map("company_registration_details")
  isPlaceholder              Boolean  @default(false) @map("is_placeholder")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("footer_content")
}

/// docs/features/insights-engine.md "Data requirements" — T4.1 (Milestone 4, Insights). One
/// of the fixed, admin-manageable taxonomy tags an `article` may carry ("Managed via
/// content-management-admin.md's Categories area — a partner creates and retires categories
/// directly, not limited to a developer-seeded list"). `isPlaceholder` is added beyond the
/// feature doc's literal id/name/slug list, same precedent as `Capability`/`MethodStage`/
/// `Page` elsewhere in this schema, since T4.4 seeds both real and illustrative categories and
/// both need to be queryable/distinguishable. No `active`/`retired` flag: content-management-
/// admin.md's own business rule is that retiring a category is a real delete of this row, not
/// a soft-hide — `Article.categoryId`'s `onDelete: SetNull` below is what implements
/// "retiring a category does not delete its articles; they fall back to no assigned category"
/// at the schema layer.
model Category {
  id            Int       @id @default(autoincrement())
  name          String
  slug          String    @unique
  isPlaceholder Boolean   @default(false) @map("is_placeholder")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  articles      Article[]

  @@map("category")
}

/// docs/features/insights-engine.md "Data requirements" — T4.1. The firm's authority-
/// instrument content unit (Document 13.03, Section 7). `publishedAt` is the single, sole
/// source of truth for visibility (null = draft) per this task's own build instruction and the
/// feature doc's business rules — there is deliberately no separate `is_published` boolean
/// anywhere on this model to fall out of sync with it; every later query (T4.2's index/filter/
/// search, T4.3's article route, Home's featured-Insights section) must filter on this field
/// directly, never a second flag. `revisedAt` is a distinct, business-meaning field from the
/// standard `updatedAt` audit column below: `updatedAt` changes on every save (including a
/// still-draft edit), while `revisedAt` is the "content substantively revised after first
/// publish" fact the feature doc names — left null for an article never revised post-publish,
/// populated by the admin publish flow (Milestone 7), not a database trigger.
///
/// `authorId` is a required FK into the existing `Author` table (T2.5, not a new entity here —
/// see this task's own note): every article has exactly one named partner author (FR-3.3),
/// `onDelete: Restrict` so a partner record can't be deleted out from under published bylines.
/// `categoryId` is nullable per the documented "article with no assigned category" edge case;
/// `onDelete: SetNull` implements content-management-admin.md's "retiring a category does not
/// delete its articles" rule directly.
///
/// `body` is an ordered array of rich-content blocks (tables, pull quotes, figures, per T4.3's
/// build note), `Json`, same "no admin editor yet to justify full relational modelling"
/// precedent as `LegalPage.body`/`Offer.methodStages`/`Offer.faqs`. `previewImage` is nullable
/// at the schema layer — content-management-admin.md's edge case is that the *admin publish
/// flow* must require a preview image before allowing publication, not that the column itself
/// is `NOT NULL` — mirroring `EnquiryRecord`'s precedent of app-layer-enforced-required over
/// schema-required for a field a row may not have yet while still a draft. `nextStepCta` is
/// the feature doc's own single named field (`next_step_cta`) modelled as one `Json` object
/// rather than several scalar columns, since the doc names it as one field (contrast `Offer.
/// ctaHref`/`ctaLabel`, two fields in that feature doc from the start) — FR-3.4's "never a
/// generic contact us" rule is an app-layer/content rule, not a schema one. Shaped
/// `{heading, body, label, href}` (revised at T4.3 from T4.1's original `{label, href}` —
/// see `lib/insights.ts`'s `ArticleNextStepCta` type and `memory/decision-log.md`, session
/// 26: the accepted mockup's next-step panel has its own heading and lead paragraph above the
/// CTA button, not just a link). No migration was needed for this revision — `Json` columns
/// have no fixed shape at the database layer, so widening the shape this application expects
/// is a pure TypeScript/documentation change, unlike a real scalar column.
///
/// `@@index` on `publishedAt` and `categoryId` exist now for T4.2's 100+-article performance
/// requirement (FR-3.6), even though T4.1 itself built no query against them.
///
/// `excerpt` was added at T4.2, beyond `insights-engine.md`'s original Data requirements list
/// — same "discovered once actually building against the mockup" precedent as `Offer.
/// ctaLabel`/`tiers` (T2.2) and `MethodStage.whatHappens` (T2.4): `ui/mockups/b-insights/
/// insights-index.html`'s article cards (and `home-page.md`'s featured-Insights cards, same
/// card shape) show a short, purpose-authored teaser distinct from the card's title and from
/// `body`'s full rich content — not something safe to auto-derive from `body` by truncation,
/// since `body` is structured blocks (tables/quotes/figures), not plain prose. Required
/// (`String`, not nullable) since a card with no excerpt has nothing to show in that slot;
/// unlike `previewImage`, there's no documented "admin publish flow enforces this, schema
/// doesn't" split for it, so it follows the same required-scalar precedent as `title`.
model Article {
  id              Int               @id @default(autoincrement())
  slug            String            @unique
  title           String
  excerpt         String
  /// Ordered rich-content blocks — see model doc-comment.
  body            Json
  authorId        Int               @map("author_id")
  author          Author            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categoryId      Int?              @map("category_id")
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?         @map("published_at")
  revisedAt       DateTime?         @map("revised_at")
  previewImage    String?           @map("preview_image")
  metaTitle       String            @map("meta_title")
  metaDescription String            @map("meta_description")
  /// `{label, href}` — see model doc-comment.
  nextStepCta     Json              @map("next_step_cta")
  isPlaceholder   Boolean           @default(false) @map("is_placeholder")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  resources       ArticleResource[]

  @@index([publishedAt])
  @@index([categoryId])
  @@map("article")
}

/// docs/features/insights-engine.md "Data requirements" — T4.1. One downloadable attachment on
/// an article (T4.3's "downloadable resources"). No `isPlaceholder` here, same precedent as
/// `OfferTier` (a child row under a parent content entity doesn't carry its own placeholder
/// flag — the parent `Article.isPlaceholder` already covers it). `fileUrl` is required, not
/// nullable: a resource row only ever exists once a real file has been attached (no "resource
/// draft with no file yet" state in the feature doc, unlike `Article.previewImage`) — T4.3's
/// own edge case, a file removed after publication, is a storage-layer/app-layer failure (the
/// row and its `fileUrl` remain; the referenced object is simply gone), not a schema
/// nullability concern. `label` is added beyond the feature doc's generic "file reference"
/// description (descriptive English, not a literal field name — same precedent as
/// `DiagnosticResponse`'s own doc-comment) since a download link needs real display text
/// distinct from its URL. `sortOrder` follows this schema's established `order`/`sortOrder`
/// precedent (`OfferTier.sortOrder`) for admin-controlled ordering of multiple resources on one
/// article.
model ArticleResource {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  label     String
  fileUrl   String   @map("file_url")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([articleId, sortOrder])
  @@map("article_resource")
}

/// docs/features/insights-engine.md "Data requirements" — T4.5. A visitor's opt-in to the
/// Insights mailing list, one of exactly two documented secondary capture routes (Document
/// 13.03 Section 6 — "lighter commitments for a visitor not yet ready for the diagnostic").
/// `email` is `@unique` — this is what makes "an already-subscribed email subscribes again:
/// no duplicate record" (insights-engine.md's own edge case) enforceable at the database
/// layer, not only by `lib/insights-subscription.ts`'s own upsert-by-email application logic.
/// `consent` has no default — every real row is created with an explicit `true` (the app
/// layer rejects anything else, T4.5's own acceptance criterion); there is deliberately no
/// separate "contact consent" field here, per insights-engine.md's business rule that the
/// signup itself is the marketing communication being consented to. `unsubscribeToken` is a
/// separate opaque unique value (`cuid()`, not the row's own sequential `id`) so a one-click
/// unsubscribe link can't be used to enumerate or unsubscribe a different visitor by guessing
/// a small integer — a deliberate choice over the simpler "use `id`" alternative, made because
/// this is a real, unauthenticated, third-party-clickable link. `unsubscribedAt` is nullable
/// and re-subscribing clears it back to `null` rather than the row ever being deleted, so a
/// visitor's subscription history is never silently lost (same "never destructive, always
/// reversible" precedent as `EnquiryRecord`).
model Subscriber {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  consent          Boolean
  unsubscribeToken String    @unique @default(cuid()) @map("unsubscribe_token")
  subscribedAt     DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")

  @@map("subscriber")
}

/// docs/features/landing-page-template.md "Data requirements" — T5.1. One `/lp/[slug]`
/// instance. `headline`/`openingParagraph` are the two fields the feature doc's own business
/// rule calls out as independently editable from the rest of the page body
/// (content-management-admin.md AC-6's literal test). `kicker` is added beyond that doc's
/// original field list — same "mockup shows more than the feature doc named" precedent as
/// `Offer.ctaLabel`/`MethodStage.whatHappens` (see memory/decision-log.md) — because all three
/// accepted mockups (`ui/mockups/d-landing-pages/*.html`) render one directly above the `<h1>`
/// and it varies per campaign, so it can't be fixed template chrome. `bodyContent` is an
/// ordered rich-content block list, same `kind`-discriminated-union convention as
/// `LegalPage.body`/`Article.body` (see `lib/landing-pages.ts`'s `LandingPageBodyBlock` for the
/// exact shape) — covers exactly the block kinds the three accepted mockups actually use, not
/// a general-purpose page builder. `isPlaceholder` follows every other seeded-content model's
/// convention (`Page`, `Offer`, `LegalPage`, `Article`, etc.) for flagging copy that isn't the
/// firm's real, final wording yet (CLAUDE.md's "never present placeholder content as final"
/// rule) — T5.2 (seeding) is what actually sets it per instance, not this task. `downloadFileUrl`
/// is added at T5.2 (session 34) — a nullable, admin-uploadable file (via the same R2 media
/// pipeline `docs/tasks/07-content-admin.md` T7.6 already plans for author photos, ADR 0004),
/// for a landing page whose call to action is a real download (e.g. the Funding-Readiness
/// Checklist) rather than a route elsewhere on the site. Null is the normal, expected state
/// before a partner uploads the real file — not technical debt — because `ctaHref`/`ctaLabel`
/// always remain a valid, real fallback destination regardless: `app/lp/[slug]/page.tsx`'s
/// `LandingPageCta` renders a real file-download link (firing the `checklist_downloaded`
/// measurement event) only when this is set, and falls back to the ordinary `ctaHref` link
/// otherwise. T7.5 (Landing Pages admin) is where a partner actually uploads/replaces this
/// field — see that task's addendum in `docs/tasks/07-content-admin.md` and
/// `memory/decision-log.md` (T5.2, session 34).
model LandingPage {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  kicker            String
  headline          String
  openingParagraph  String   @map("opening_paragraph")
  /// Ordered rich-content blocks — see model doc-comment.
  bodyContent       Json     @map("body_content")
  ctaLabel          String   @map("cta_label")
  ctaHref           String   @map("cta_href")
  /// Nullable — see model doc-comment. Null until a partner uploads a real file via T7.5's
  /// future admin editor; `app/lp/[slug]/page.tsx` falls back to `ctaHref`/`ctaLabel` when null.
  downloadFileUrl   String?  @map("download_file_url")
  /// Internal campaign tracking, distinct from the UTM parameters captured per visit
  /// (`measurement-and-attribution.md`) — not rendered anywhere on the page itself.
  campaignReference String   @map("campaign_reference")
  metaTitle         String   @map("meta_title")
  metaDescription   String   @map("meta_description")
  isPlaceholder     Boolean  @default(false) @map("is_placeholder")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("landing_page")
}

/// docs/features/admin-authentication.md "Data requirements" — T6.1 (Milestone 6, Admin
/// Authentication). One partner's login identity — separate from `Author` (their public
/// profile above); `Author.adminUserId` remains the schema-only placeholder FK its own
/// doc-comment already describes (not wired to a real relation by this task — a future
/// content-admin task's job, not this one's).
///
/// `role` is a real `AdminRole` enum (`OWNER`/`PARTNER`) — reversed from this field's
/// original plain-string reasoning (session 60): that reasoning held only while no feature
/// doc defined a closed vocabulary to gate on; a real one now exists (`docs/features/
/// admin-authentication.md`'s Owner/Partner permission split, added session 60 after `role`
/// was found to be pure unused scaffolding — see `memory/decision-log.md`), and a closed
/// 2-value set is exactly the case `EnquiryStatus` already sets the enum precedent for.
/// Defaults to `PARTNER`, the normal case for a newly invited account.
///
/// `passwordHash` is produced by `lib/auth/password.ts` (`bcryptjs` — a vetted, pure-JS
/// bcrypt implementation, chosen over the native-binding `bcrypt`/`argon2` packages
/// specifically to avoid Railway's isolated build-container native-compile risk, a real,
/// already-hit failure mode on this project twice over for unrelated reasons — see
/// `memory/decision-log.md`, T6.1). `totpSecret` stores the *encrypted* value produced by
/// `lib/auth/totp-encryption.ts` (AES-256-GCM via Node's own `crypto` module and a
/// server-held key, `ADMIN_TOTP_ENCRYPTION_KEY`) — reversible, unlike `passwordHash`,
/// because TOTP verification needs the live plaintext secret to compute the current code
/// (see that file's doc-comment and `memory/decision-log.md` for the full reasoning). Both
/// helpers live in the new `lib/auth/` directory this task establishes, per CLAUDE.md's Auth
/// Pattern section.
///
/// `totpSecret` is nullable: a newly created account has no secret until it completes
/// `/admin/setup-2fa` (T6.2). `totpEnabled` is the separate, explicit gate
/// `admin-authentication.md`'s Data requirements section names — never inferred from
/// `totpSecret` being non-null, since T6.2's real flow generates a secret *before*
/// confirmation (a row can have a `totpSecret` with `totpEnabled` still `false` mid-setup).
/// `lastLoginAt` is nullable for the same "never happened yet" reason. `createdAt` is the
/// feature doc's own named field (no `updatedAt` companion — not named in that doc's Data
/// requirements list, and nothing about this model needs a general last-modified audit
/// column the way content-editing models do).
/// `setupToken`/`setupTokenExpiresAt` — added at T6.2, beyond `admin-authentication.md`'s
/// original id/name/email/password_hash/role/totp_secret/totp_enabled/created_at/
/// last_login_at list, same "gap discovered once actually building the screen" precedent as
/// `Offer.ctaLabel`/`tiers` (T2.2) and others (see `memory/decision-log.md`, T6.2). No task
/// in this epic builds account *creation* — every task from T6.1 on assumes an `admin_user`
/// row already exists (T6.2's own Input→Output: "New `admin_user`... → confirmed TOTP
/// enrolment") — so `/admin/setup-2fa` needs a way to resolve "which account is this setup
/// link for" without a login session (none exists pre-enrolment) and without a guessable
/// sequential id in the URL (this is a real, unauthenticated, third-party-clickable link —
/// same class of problem `Subscriber.unsubscribeToken` already solves for a different reason;
/// a raw `?userId=3` would let anyone enumerate accounts and view/regenerate a live partner's
/// pending TOTP secret). `setupToken` is a single-use opaque value, nulled the moment setup
/// completes (`lib/auth/totp-setup.ts`'s `confirmTotpSetup`); `setupTokenExpiresAt` bounds
/// how long a stale, never-completed link stays valid. Neither field means an account-
/// creation flow exists yet — see `memory/technical-debt.md` → "No task provisions a real
/// `admin_user` row yet" for the still-open gap this doesn't close.
///
/// `lastVerifiedTotpStep` — added at T6.3 for login's own replay-protection acceptance
/// criterion ("a replayed TOTP code within the same time window is rejected even though it
/// hasn't expired," `docs/tasks/06-admin-auth.md`). `otplib`'s `verify` accepts an
/// `afterTimeStep` option built for exactly this: reject any code whose RFC 6238 time step is
/// `<=` the last one this account successfully verified at — no hand-rolled comparison, the
/// vetted library already does it (ADR 0007). `lib/auth/login.ts` writes the real,
/// library-returned `result.timeStep` here after every successful login verification. Not
/// exercised by T6.2's `confirmTotpSetup` — a setup token is already single-use by
/// construction, so it has no repeat-verification window to protect against replay within.
///
/// `active` — added at T6.5, beyond `admin-authentication.md`'s original Data requirements
/// list, same "gap found building the real thing" pattern as every field added to this model
/// before it. Backs that same doc's own edge case ("a partner account is deactivated... session
/// invalidated immediately, not merely on next login") — `lib/auth/session.ts`'s
/// `deactivateAdminUser` flips this to `false` and deletes every live `AdminSession` row for
/// the account in one transaction; `verifySession` also checks it directly on every lookup
/// (defense in depth, not reliance on the delete alone), and `lib/auth/login.ts`'s
/// `loginWithPassword` refuses to issue even a challenge token for an inactive account, so a
/// deactivated partner can't start a fresh session either. Defaults `true` — every account is
/// active until an admin says otherwise. No UI sets this yet (Milestone 7's Team area, per
/// this task's own Input→Output line) — `lib/`-level only, same as `setupToken` before any
/// screen read/wrote it.
///
/// `passwordResetToken`/`passwordResetTokenExpiresAt` — added at T6.7. Same opaque-single-use-
/// link shape as `setupToken`/`setupTokenExpiresAt` above (and the same reasoning: an
/// unauthenticated, third-party-clickable link needs a real unguessable identifier, never a
/// sequential id), but deliberately a *separate* pair of columns rather than reusing
/// `setupToken` itself — the two links serve unrelated purposes (one enrolls a TOTP device,
/// the other only ever touches `password_hash`) and can legitimately be pending at once (e.g.
/// a partner requests a password reset while a stale, never-completed setup link from T6.6 is
/// still technically live) — collapsing them into one column would make issuing one silently
/// invalidate the other. `passwordResetToken` is nulled the moment a reset completes
/// (`lib/auth/password-reset.ts`'s `confirmPasswordReset`) or superseded by requesting a new
/// one (`issuePasswordResetToken` always overwrites in place, so only the most recent request
/// for a given account is ever valid); `passwordResetTokenExpiresAt` bounds how long a
/// requested-but-unused link stays valid — a much shorter window (1 hour) than
/// `setupTokenExpiresAt`'s 7 days, since this link is requested on demand by the partner who
/// needs it right now, not handed over through an out-of-band channel with its own delay.
model AdminUser {
  id                          Int               @id @default(autoincrement())
  name                        String
  email                       String            @unique
  passwordHash                String            @map("password_hash")
  role                        AdminRole         @default(PARTNER)
  /// AES-256-GCM ciphertext (iv/authTag/ciphertext, base64-joined) — never the raw secret.
  /// See model doc-comment.
  totpSecret                  String?           @map("totp_secret")
  totpEnabled                 Boolean           @default(false) @map("totp_enabled")
  createdAt                   DateTime          @default(now()) @map("created_at")
  lastLoginAt                 DateTime?         @map("last_login_at")
  /// Opaque, single-use `/admin/setup-2fa` link token — see model doc-comment. Null once
  /// unused (never issued) or once consumed (setup completed).
  setupToken                  String?           @unique @map("setup_token")
  setupTokenExpiresAt         DateTime?         @map("setup_token_expires_at")
  /// RFC 6238 time step of the last successfully verified login TOTP code — see model
  /// doc-comment. Null for an account that has never completed a login yet.
  lastVerifiedTotpStep        Int?              @map("last_verified_totp_step")
  /// `false` once an admin deactivates this account — see model doc-comment.
  active                      Boolean           @default(true)
  /// Opaque, single-use `/admin/reset-password` link token — see model doc-comment. Null once
  /// unused (never requested), once consumed (reset completed), or once superseded by a newer
  /// request.
  passwordResetToken          String?           @unique @map("password_reset_token")
  passwordResetTokenExpiresAt DateTime?         @map("password_reset_token_expires_at")
  backupCodes                 AdminBackupCode[]
  sessions                    AdminSession[]
  /// Back-relation to `Author.adminUserId` (T7.6) — null for the dev/test-only account this
  /// project's own local admin-provisioning script creates, which is deliberately not tied
  /// to any real partner's public profile.
  author                      Author?
  /// Back-relation to `EnquiryRecord.assignedPartnerId` (T8.1) — every enquiry this partner
  /// is currently assigned to. Empty for most accounts most of the time; assignment is
  /// optional per `enquiry-management.md`.
  assignedEnquiries           EnquiryRecord[]

  @@map("admin_user")
}

/// docs/features/admin-authentication.md "Data requirements" — T6.1. One single-use recovery
/// code, generated in a batch at `/admin/setup-2fa` (T6.2) and consumed by
/// `POST /api/admin/auth/verify-backup-code` (T6.4) when a partner has lost their
/// authenticator device. `codeHash` reuses the same `lib/auth/password.ts` hash/verify
/// functions as `AdminUser.passwordHash` — a backup code is a credential exactly like a
/// password (one-way verification only, never recovered in plaintext, unlike the TOTP
/// secret), so it gets the same one-way-hash treatment; T6.2/T6.4 are what actually generate
/// and check codes, not this task. `usedAt` is nullable — null means still valid; consuming a
/// code sets this rather than deleting the row, so "this code was already used" stays a real,
/// traceable fact instead of the row simply vanishing (mirrors this schema's established
/// "never destructive, always reversible/traceable" precedent, e.g. `Subscriber.
/// unsubscribedAt`). No `createdAt` here: the feature doc's own field list for this entity
/// (id, admin_user_id, code_hash, used_at) doesn't name one, and nothing about backup-code
/// recovery (T6.4's edge cases) needs a creation timestamp the way session expiry needs
/// `AdminSession.createdAt` below.
model AdminBackupCode {
  id          Int       @id @default(autoincrement())
  adminUserId Int       @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  codeHash    String    @map("code_hash")
  usedAt      DateTime? @map("used_at")

  @@map("admin_backup_code")
}

/// docs/features/admin-authentication.md "Data requirements" — T6.1. One TOTP-verified admin
/// session, created only by `POST /api/admin/auth/verify-totp` or `verify-backup-code`
/// (T6.3/T6.4) — never by the password step alone (that doc's Interfaces section: the login
/// endpoint returns a challenge token, not a session). `expiresAt` is what the epic header's
/// 12-hour absolute-lifetime policy writes into on creation (implemented at T6.3, this task).
/// `onDelete: Cascade` on the FK is what makes T6.5's "invalidate all of a deactivated user's
/// live sessions immediately" a straightforward per-user row delete; `@@index([adminUserId])`
/// supports that same per-user lookup, and looking a session up by its own `id` (a per-session
/// invalidation, T6.5's other requirement) is already covered by the primary key.
///
/// `token`/`lastActivityAt` — added at T6.3, beyond `admin-authentication.md`'s original
/// id/admin_user_id/created_at/expires_at list (same "gap found building the real thing"
/// precedent as `AdminUser.setupToken`, T6.2). `token` is the actual opaque, random value
/// `lib/auth/session.ts` puts in the session cookie — never this row's own sequential `id`,
/// which would make a session cookie a guessable small integer (same reasoning as
/// `AdminUser.setupToken`/`Subscriber.unsubscribeToken`). `lastActivityAt` is what makes the
/// epic's 30-minute-inactivity policy real: `lib/auth/session.ts`'s `verifySession` bumps it
/// on every authenticated request and rejects (deletes) the session once it's stale, entirely
/// independent of `expiresAt`'s own fixed 12-hour absolute ceiling — a session can die from
/// either rule, whichever comes first.
model AdminSession {
  id             Int       @id @default(autoincrement())
  adminUserId    Int       @map("admin_user_id")
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// The session cookie's actual value — see model doc-comment.
  token          String    @unique
  createdAt      DateTime  @default(now()) @map("created_at")
  lastActivityAt DateTime  @map("last_activity_at")
  expiresAt      DateTime  @map("expires_at")

  @@index([adminUserId])
  @@map("admin_session")
}

/// New at T6.3 — not named in `admin-authentication.md`'s Data requirements section (which
/// only lists the three T6.1 tables), but required to build that same doc's own business rule
/// ("repeated failed login or TOTP attempts: rate-limited to prevent brute-force") for real,
/// across all four code/credential-guessing endpoints this epic ends up with:
/// `POST /api/admin/auth/login` (`kind: password`), `verify-totp` (`kind: totp`, T6.3),
/// `POST /api/admin/auth/setup-2fa` (`kind: setup_confirm`, T6.2 — see that task's own
/// addendum in `docs/tasks/06-admin-auth.md` requiring this task to cover it too), and
/// `verify-backup-code` (`kind: backup_code`, T6.4). `identifier`
/// is always the target account's normalized email — chosen over the ephemeral
/// `challenge_token`/`setup_token` a given attempt carries specifically so an attacker who can
/// mint fresh tokens for the same account (e.g. by re-submitting an already-known-correct
/// password to get a new `challenge_token`) doesn't get a fresh rate-limit budget each time;
/// one email, one shared budget, regardless of which token happened to carry a given attempt.
/// `success` is recorded for both outcomes (not failures only) so `lib/auth/rate-limit.ts`'s
/// window-count query is a plain `WHERE success = false`, not a subtraction. A plain table,
/// not an in-memory counter — Railway can redeploy/restart the app process at any time (a
/// counter living only in memory wouldn't survive that), and CLAUDE.md's own architecture
/// constraint for this task requires the rate-limit store to be real, not an afterthought. No
/// retention/cleanup job exists yet for this table (unlike `Attribution`'s 90-day job, T5.4) —
/// proportionate for now given real volume (five partners, occasional logins), not an
/// oversight; revisit if that volume ever changes.
model AdminLoginAttempt {
  id         Int                   @id @default(autoincrement())
  identifier String
  kind       AdminLoginAttemptKind
  success    Boolean
  createdAt  DateTime              @default(now()) @map("created_at")

  @@index([identifier, kind, createdAt])
  @@map("admin_login_attempt")
}

/// The code/credential-guessing and request-flood steps `AdminLoginAttempt` rate-limits —
/// see that model's own doc-comment for why `setup_confirm` (T6.2's endpoint) is included
/// here even though this enum itself is new at T6.3. `backup_code` added at T6.4 for
/// `verify-backup-code`'s own recovery-code guessing surface.
///
/// `password_reset_request`/`password_reset_confirm` added at T6.7 for
/// `lib/auth/password-reset.ts`'s two steps — deliberately *two* kinds, not one, because they
/// guard different things: `password_reset_confirm` is a guessing surface exactly like
/// `setup_confirm` (a submitted token/new-password pair, throttled by `assertNotRateLimited`'s
/// existing failure-counting logic), while `password_reset_request` isn't guessable at all —
/// every request "succeeds" from the caller's own point of view regardless of whether the
/// submitted email matches a real account (`requestPasswordReset`'s own no-account-enumeration
/// rule) — so it's throttled by `lib/auth/rate-limit.ts`'s separate `assertNotFlooded` (total
/// attempts in a window, not failures) instead, guarding against a real account being
/// flooded with reset emails rather than against credential-guessing.
///
/// `change_password_confirm` added at session 60 for `lib/auth/change-password.ts`'s
/// self-service, in-session "change my password" flow (`changeOwnPassword`) — a real
/// guessing surface exactly like `password_reset_confirm` (a submitted current-password
/// value, throttled by `assertNotRateLimited`'s failure-counting logic), distinct from it
/// because the two flows verify different things (a reset token vs. a live session's own
/// current password) and can legitimately fail independently of one another.
enum AdminLoginAttemptKind {
  password
  totp
  setup_confirm
  backup_code
  password_reset_request
  password_reset_confirm
  change_password_confirm
}

/// `docs/features/admin-authentication.md`'s Owner/Partner permission split, added session
/// 60 to close a real gap: `AdminUser.role` had existed since T6.1 as a plain string but was
/// never read by a single authorization check anywhere in the app (see `memory/decision-
/// log.md`'s T7.6 entry) — any logged-in partner could edit, deactivate, or reset any other
/// partner's account. OWNER can invite/create partners, manage any login (deactivate/
/// reactivate/reset 2FA/reset password/change role), edit any partner's public profile, and
/// toggle any profile's published state. PARTNER can only manage their own login and profile.
enum AdminRole {
  OWNER
  PARTNER
}

/// docs/features/measurement-and-attribution.md "Data requirements" — T5.4. First-touch
/// campaign attribution for one browsing session, captured client-side
/// (`lib/attribution-client.ts`) the moment a visitor first lands (any page, not only
/// `/lp/[slug]` — Document 13.03's own examples include a shared article and a direct
/// campaign URL, not just paid landing pages) and sent along with whichever `enquiry_record`
/// that same browsing session eventually produces. `sessionId` is a client-generated
/// (`crypto.randomUUID()`), `localStorage`-persisted id — a different concept from
/// `DiagnosticResponse.sessionId` (that one has "no real visitor-session concept to draw
/// on," per its own doc-comment; this one does, deliberately, as the whole point of this
/// model) — `@unique` so a resend from the same browser session resolves to the same row
/// (upsert-by-sessionId) rather than creating a duplicate. `utmSource`/`utmMedium`/
/// `utmCampaign` are nullable — this row is still created for a direct/organic visitor with
/// no campaign parameters at all (`landingPage`/`firstSeen` are always real), matching this
/// task's own edge case ("a session with no campaign parameters stores null/direct, never
/// blocking the flow") — the fields being null *is* how "direct" is represented, not a
/// missing row. `firstSeen` is the row's own meaningful timestamp (when the visitor actually
/// first landed, captured client-side) — the 90-day retention job
/// (`lib/attribution-cleanup.ts`) ages off this field, not `createdAt`, though in practice
/// the two are captured within moments of each other.
model Attribution {
  id          Int             @id @default(autoincrement())
  sessionId   String          @unique @map("session_id")
  utmSource   String?         @map("utm_source")
  utmMedium   String?         @map("utm_medium")
  utmCampaign String?         @map("utm_campaign")
  landingPage String          @map("landing_page")
  firstSeen   DateTime        @map("first_seen")
  createdAt   DateTime        @default(now()) @map("created_at")
  enquiries   EnquiryRecord[]

  @@map("attribution")
}
