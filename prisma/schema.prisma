// Prisma schema baseline (T1.2). Entities are added incrementally, epic by epic, as each
// docs/features/*.md's "Data requirements" section is built against (see CLAUDE.md's
// "Every entity field named in a docs/features/*.md ... maps to a Prisma schema field"
// rule). The migration tooling and conventions here are what every later epic's tasks
// build on.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// docs/features/home-page.md "Data requirements". Singleton row (queried via findFirst,
/// seeded/upserted with a fixed id) — no `site_settings`-style multi-tenancy applies here,
/// there is exactly one home page. Only the fields home-page.md's Data requirements section
/// actually names are modelled; the mockup's hero kicker, hero facts sidebar, method-strip
/// step copy, and trust band are fixed template chrome (not named as editable data in that
/// section) rather than an undocumented field invented for them — see memory/decision-log.md
/// (T2.1) for the reasoning.
model HomePageContent {
  id                  Int      @id @default(autoincrement())
  heroStatement       String   @map("hero_statement")
  primaryCtaLabel     String   @map("primary_cta_label")
  primaryCtaHref      String   @map("primary_cta_href")
  seniorAttentionCopy String   @map("senior_attention_copy")
  /// Up to 3 `article` ids; empty = most-recent-fallback per home-page.md's edge cases.
  /// No `article` table exists yet (insights-engine.md is Milestone 4, not built yet), so
  /// this is currently always empty and lib/home.ts's featured-articles resolver always
  /// returns none — see the code comment there.
  featuredArticleIds  Int[]    @default([]) @map("featured_article_ids")
  metaTitle           String   @map("meta_title")
  metaDescription     String   @map("meta_description")
  isPlaceholder       Boolean  @default(false) @map("is_placeholder")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("home_page_content")
}

/// docs/features/core-offer-pages.md "Data requirements" — full entity as of T2.2 (Core
/// Offer pages). `teaser` was added at T2.1 for the home/capabilities card blurb. T2.2 added
/// every remaining documented field, plus two fields not named in the feature doc but needed
/// once the full detail page was actually built (see memory/decision-log.md, T2.2):
/// `ctaLabel` (the doc only named `cta_href`, but the fee-panel CTA's button text differs per
/// offer — "Start with the free Health Check" vs. "Start a conversation" — and that's
/// firm-editable copy same as the href), and the `tiers` relation (`OfferTier`, below), which
/// resolves the Business Health Check two-tier pricing gap flagged at T2.1
/// (memory/technical-debt.md). `deliverables`/`clientInputs`/`indicativeTimeline` are used
/// directly by a single-tier offer (Financial Clarity Pack, Funding-Readiness Pack, whose
/// `tiers` relation is empty); a tiered offer (Business Health Check) leaves these three
/// empty/null on the parent row and carries the equivalent data per-tier instead, since each
/// tier has its own deliverables, required inputs and timeline. `methodStages`/`faqs` are
/// ordered lists stored as `Json` ({title, description}[] / {question, answer}[] respectively,
/// see lib/offers.ts's `MethodStage`/`OfferFaq` types) — no admin editor exists yet
/// (Milestone 7) to justify a fully relational shape for these today.
model Offer {
  id                 Int         @id @default(autoincrement())
  slug               String      @unique
  name               String
  teaser             String
  problemStatement   String      @map("problem_statement")
  whoFor             String      @map("who_for")
  whoNotFor          String      @map("who_not_for")
  /// Ordered `{title, description}[]`.
  methodStages       Json        @map("method_stages")
  /// Empty when this offer uses `tiers` instead (see model doc-comment above).
  deliverables       String[]    @default([])
  /// Empty when this offer uses `tiers` instead. A "list" per the feature doc even where a
  /// single-tier offer's mockup renders one paragraph — seeded as a one-element array so the
  /// render (`array.map` over `<p>`) reproduces the mockup exactly without special-casing.
  clientInputs       String[]    @default([]) @map("client_inputs")
  /// Null when this offer uses `tiers` instead (each tier carries its own `durationLabel`).
  indicativeTimeline String?     @map("indicative_timeline")
  feeAmountMin       Int         @map("fee_amount_min")
  feeAmountMax       Int         @map("fee_amount_max")
  feeCurrency        String      @map("fee_currency")
  scopeCap           String      @map("scope_cap")
  outOfScopeNote     String      @map("out_of_scope_note")
  /// Ordered `{question, answer}[]`, 3–5 real entries per core-offer-pages.md's business rule.
  faqs               Json
  ctaHref            String      @map("cta_href")
  ctaLabel           String      @map("cta_label")
  metaTitle          String      @map("meta_title")
  metaDescription    String      @map("meta_description")
  isPlaceholder      Boolean     @default(false) @map("is_placeholder")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  tiers              OfferTier[]

  @@map("offer")
}

/// New at T2.2 — resolves "Business Health Check's two-tier pricing has no real data model
/// yet" (memory/technical-debt.md). Only Business Health Check has rows here today; a
/// single-tier offer's `Offer.tiers` is simply empty and its own top-level
/// deliverables/clientInputs/indicativeTimeline/fee fields are used instead (see `Offer`'s
/// doc-comment). `isFeatured` marks which tier the offer detail page's fee-panel section
/// presents as "the published fee band" (BHC's own mockup: the Full tier) — the other
/// tier(s) surface as the panel's "alt-note" instead, by fee floor + duration.
model OfferTier {
  id            Int      @id @default(autoincrement())
  offerId       Int      @map("offer_id")
  offer         Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  name          String
  isFeatured    Boolean  @default(false) @map("is_featured")
  durationLabel String   @map("duration_label")
  /// Short form for the tier-meta line ("5 working days · single-location business"), e.g.
  /// "single-location business".
  scopeLabel    String   @map("scope_label")
  /// Full form for the fee-panel's "Scope cap:" line (FR-4.1's fee-band-plus-scope-cap
  /// element) — a fuller description than `scopeLabel`, e.g. Full's "up to 3 locations or
  /// business lines, 12 months of available records" vs. its `scopeLabel`'s shorter "up to
  /// three locations or business lines".
  scopeCap      String   @map("scope_cap")
  feeAmountMin  Int      @map("fee_amount_min")
  feeAmountMax  Int      @map("fee_amount_max")
  feeCurrency   String   @map("fee_currency")
  deliverables  String[] @default([])
  /// Same one-element-array-for-a-paragraph convention as `Offer.clientInputs`.
  clientInputs  String[] @default([]) @map("client_inputs")
  sortOrder     Int      @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([offerId, sortOrder])
  @@map("offer_tier")
}

/// The shared generic marketing-page entity (CLAUDE.md's Recurring Patterns: "the home for a
/// marketing page's own copy when it has no other entity to attach to"). New at T2.3
/// (Capabilities), keyed by `slug` since more than one page shares this model —
/// `capabilities-page.md`'s "Data requirements" names id/slug/hero_kicker/hero_heading/
/// hero_lead/meta_title/meta_description; `introCopy` isn't part of that list but is added
/// now per T2.3's own architecture constraint ("our-method-page.md (T2.4) reuses the same
/// page model with an added intro_copy field, so design it as a real shared model from the
/// start") — nullable and unused by the capabilities row.
model Page {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  heroKicker      String   @map("hero_kicker")
  heroHeading     String   @map("hero_heading")
  heroLead        String   @map("hero_lead")
  /// Unique to our-method-page.md (T2.4) — null for every other page's row, including
  /// capabilities.
  introCopy       String?  @map("intro_copy")
  metaTitle       String   @map("meta_title")
  metaDescription String   @map("meta_description")
  isPlaceholder   Boolean  @default(false) @map("is_placeholder")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("page")
}

/// docs/features/capabilities-page.md "Data requirements" — one of the 8 service-line
/// summaries on /capabilities. `order` is the field name the feature doc itself names (not
/// `sortOrder`, unlike `OfferTier.sortOrder` above, per CLAUDE.md's "every entity field named
/// in a docs/features/*.md ... maps to a Prisma schema field of the same name" rule).
model Capability {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  shortDescription String   @map("short_description")
  order            Int
  isPlaceholder    Boolean  @default(false) @map("is_placeholder")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("capability")
}

/// docs/features/capabilities-page.md "Data requirements" — a singleton (same
/// findFirst-by-fixed-id pattern as `HomePageContent`), deliberately a single recurring
/// `feeAmount` + `billingPeriod` rather than `OfferTier`'s multi-tier shape or the three core
/// offers' fee_amount_min/max band: a retainer is priced as one figure per period, not a
/// range with a scope cap (capabilities-page.md's business rules; core-offer-pages.md's band
/// shape doesn't apply here).
model AdvisoryRetainer {
  id            Int      @id @default(autoincrement())
  feeAmount     Int      @map("fee_amount")
  feeCurrency   String   @map("fee_currency")
  billingPeriod String   @map("billing_period")
  description   String
  isPlaceholder Boolean  @default(false) @map("is_placeholder")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("advisory_retainer")
}

/// docs/features/our-method-page.md "Data requirements" — one of the 4 stages of the firm's
/// method (Discover, Diagnose, Design, Deliver), rendered on /our-method in fixed order.
/// `order` follows `Capability.order`'s naming precedent (the feature doc's own field name,
/// not `sortOrder`). `whatHappens` is an added field beyond the feature doc's original
/// description/client_sees/decision_point list — needed once the page was built against
/// ui/mockups/a-public-site/our-method.html, whose `.stage-detail-grid` has three cells
/// ("What happens", "What the client sees", "Decision point") in addition to each stage's own
/// longer descriptive paragraph (`description`) — same precedent as T2.2 adding
/// `Offer.ctaLabel`/`tiers` beyond their feature doc's original field list (see
/// memory/decision-log.md). `capabilityTransferNote` is populated only for the final
/// (Deliver) stage per the feature doc's business rule — null for the other three.
model MethodStage {
  id                     Int      @id @default(autoincrement())
  name                   String
  order                  Int      @unique
  description            String
  whatHappens            String   @map("what_happens")
  clientSees             String   @map("client_sees")
  decisionPoint          String   @map("decision_point")
  capabilityTransferNote String?  @map("capability_transfer_note")
  isPlaceholder          Boolean  @default(false) @map("is_placeholder")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("method_stage")
}

/// docs/features/about-and-partners-page.md "Data requirements" — the founding
/// statement/values/standard `firm_statement` entity, decomposed into named fields the same
/// way `HomePageContent`/`Offer`/`MethodStage` decompose their own mockup sections, rather
/// than one opaque rich-text blob (the feature doc's one-line "rich content" description
/// doesn't preclude this — the mockup's four numbered value cards and two distinct panels
/// need their own fields to render, same reasoning as T2.4 adding `MethodStage.whatHappens`
/// beyond its feature doc's original list). Singleton row, same `findFirst`-by-fixed-id
/// pattern as `HomePageContent`/`AdvisoryRetainer`. The page's own hero
/// (kicker/heading/lead/meta) reuses the shared `Page` model instead (slug `"about"`), same
/// as capabilities/our-method — this entity holds only the content below the hero.
model FirmStatement {
  id             Int      @id @default(autoincrement())
  standingIntro  String   @map("standing_intro")
  /// Fixed 4-item ordered list ("What we stand on"'s value cards) — Integrity, Excellence,
  /// Partnership, Impact. A plain string array, not `Json`, since each value is just a name
  /// with no other per-value content in the mockup.
  values         String[]
  forwardHeading String   @map("forward_heading")
  forwardBody    String   @map("forward_body")
  /// "What we are not" panel's body paragraph — the panel heading itself is fixed template
  /// chrome (a standard compliance-disclaimer heading), not modelled as a field.
  scopeBody      String   @map("scope_body")
  isPlaceholder  Boolean  @default(false) @map("is_placeholder")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("firm_statement")
}

/// docs/features/about-and-partners-page.md / content-management-admin.md "Data
/// requirements" — shared with the not-yet-built insights-engine.md (article bylines).
/// `adminUserId` models the doc's `admin_user_id` FK for schema completeness only — no
/// `admin_user` table exists yet (Milestone 6, admin authentication), same precedent as
/// `HomePageContent.featuredArticleIds` pointing at the not-yet-built `article` table (T2.1,
/// see memory/decision-log.md) — not exercised by this task.
///
/// `photoUrl`/`credentials` are nullable, and `published` no longer gates on photo readiness
/// the way about-and-partners-page.md's original edge case specified — revised during T2.5
/// per explicit firm direction (memory/decision-log.md, session 11): a partner with no photo
/// yet still publishes, rendered with an initials avatar in `photoUrl`'s place (never a fake
/// placeholder image standing in for a real one), swapped for the real photo the moment one
/// is uploaded — no publish-state change required. `credentials` is similarly nullable where
/// a partner has no formal designation to state yet — never fabricated to fill the field,
/// rendered only when present. `published` still gates on the other required fields (name,
/// practiceArea, personalStatement, bio) per content-management-admin.md's publish-gating
/// rule.
///
/// `order` follows `Capability.order`/`MethodStage.order`'s naming precedent (not named in
/// the feature doc) — needed to render exactly one partner as the page's single featured
/// "Lead Partner" card and the rest in a grid, in a stable, admin-editable order; the lowest
/// `order` value is the featured entry (see lib/about.ts's `getAuthors`).
model Author {
  id                Int      @id @default(autoincrement())
  adminUserId       Int?     @map("admin_user_id")
  name              String
  photoUrl          String?  @map("photo_url")
  practiceArea      String   @map("practice_area")
  credentials       String?
  personalStatement String   @map("personal_statement")
  bio               String
  order             Int
  published         Boolean  @default(false)
  isPlaceholder     Boolean  @default(false) @map("is_placeholder")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("author")
}
