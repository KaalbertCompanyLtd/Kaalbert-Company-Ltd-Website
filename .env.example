# Copy this file to .env.local (or .env.production, for a local production-build test) and
# fill in real values. Never commit either — see CLAUDE.local.md for what each of these is
# and where to find the real value.

# Railway Postgres connection string (dev/staging). Locally this must be the public
# proxy URL (railway tcp-proxy create --port 5432 --service Postgres), since the
# RAILWAY_PRIVATE_DOMAIN-based URL Railway injects into the app service only resolves
# inside Railway's own network.
DATABASE_URL=

# HMAC key signing the short-lived challenge token issued between the password and TOTP
# steps of admin login (T6.3, docs/tasks/06-admin-auth.md; lib/auth/challenge-token.ts —
# ADR 0007). Renamed from this var's original placeholder name NEXTAUTH_SECRET at T6.3: this
# project never adopted the `next-auth` package (ADR 0001), so that name risked implying a
# dependency this codebase deliberately doesn't have. Any random string works; generate one
# with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_CHALLENGE_TOKEN_SECRET=

# Symmetric key admin_user.totp_secret is encrypted/decrypted with (T6.1, docs/tasks/
# 06-admin-auth.md; lib/auth/totp-encryption.ts) — AES-256-GCM, so this must be a 64-character
# hex string (32 bytes). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this key makes every already-stored totp_secret undecryptable — every
# affected partner would need to re-enroll via /admin/setup-2fa (T6.2).
ADMIN_TOTP_ENCRYPTION_KEY=

# Absolute site origin used for sitemap/canonical/OG URLs and the Organization JSON-LD
# (lib/seo.ts). kaalbert.com was registered and added as a Railway custom domain 2026-09-16
# (session 62) — set this explicitly to https://kaalbert.com in every real environment
# (.env.local, .env.production, and the live Railway service) rather than relying on the
# code fallback. Apex domain, not www — www.kaalbert.com has no DNS record and is not a
# Railway custom domain today.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager container ID (ADR 0006).
GTM_CONTAINER_ID=

# Meta Conversions API access token (ADR 0006).
META_CAPI_ACCESS_TOKEN=

# Brevo transactional email (T3.7, docs/tasks/03-diagnostic.md) — the diagnostic's gated
# summary-request email, and the shared send utility Milestone 4/8 reuse. Get the API key
# from Brevo's dashboard, Transactional tab -> API Keys. BREVO_SENDER_EMAIL must be a
# verified sender (Brevo dashboard, Senders) before sending will succeed — currently
# kaalbert.company@gmail.com, verified via Brevo's single-sender flow (chosen originally
# because it needed no registered domain). Now that kaalbert.com is registered, the
# recommended upgrade is domain authentication (Brevo dashboard -> Senders, Domains &
# Dedicated IPs -> Domains -> Authenticate a domain for kaalbert.com) plus a dedicated
# no-reply@kaalbert.com sender — see memory/technical-debt.md and
# docs/vendor-operations-guide.md Section 3 for the exact steps; not done yet.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Kaalbert & Company Ltd

# Cloudflare R2 object storage — provisioned 2026-09-11. The first four are the S3-compatible
# API credentials (Object Read & Write, scoped to just this bucket) used server-side for
# uploads (lib/media-storage.ts) — never exposed to the browser. CLOUDFLARE_R2_PUBLIC_URL is
# a *separate* concern: the bucket's own public-read base URL (R2.dev subdomain or a custom
# domain, enabled in the bucket's Settings > Public access), used to build the URL a visitor's
# browser actually fetches the uploaded file from. One bucket does both jobs at once —
# authenticated writes via the API credentials, anonymous reads via the public URL — there is
# no separate "private" bucket.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_PUBLIC_URL=

# Phase 2, added only when each capability's evidence trigger is met (docs/scope.md):
# PAYSTACK_SECRET_KEY=            # Milestone 13
# (calendar-sync API credentials) # Milestone 10
# (CRM webhook target + auth)     # Milestone 15
