# Copy this file to .env.local (or .env.production, for a local production-build test) and
# fill in real values. Never commit either — see CLAUDE.local.md for what each of these is
# and where to find the real value.

# Railway Postgres connection string (dev/staging). Locally this must be the public
# proxy URL (railway tcp-proxy create --port 5432 --service Postgres), since the
# RAILWAY_PRIVATE_DOMAIN-based URL Railway injects into the app service only resolves
# inside Railway's own network.
DATABASE_URL=

# Session-signing secret (or equivalent, once the auth library is chosen — see ADR 0007).
NEXTAUTH_SECRET=

# Absolute site origin used for sitemap/canonical/OG URLs and the Organization JSON-LD
# (lib/seo.ts). Falls back to https://www.kaalbert.com (docs/vision.md) when unset — only
# needs a real value for a preview/staging deploy at a different domain.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager container ID (ADR 0006).
GTM_CONTAINER_ID=

# Meta Conversions API access token (ADR 0006).
META_CAPI_ACCESS_TOKEN=

# Cloudflare R2 object storage credentials — added once R2 is provisioned (ADR 0004).
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=

# Phase 2, added only when each capability's evidence trigger is met (docs/scope.md):
# PAYSTACK_SECRET_KEY=            # Milestone 13
# (calendar-sync API credentials) # Milestone 10
# (CRM webhook target + auth)     # Milestone 15
